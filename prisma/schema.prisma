datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Ticket {
  id          Int      @id @default(autoincrement())
  clientName  String
  clientPhone String
  serviceType String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
}
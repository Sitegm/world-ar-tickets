datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Ticket {
  id          Int      @id @default(autoincrement())
  clientName  String
  clientPhone String
  serviceType String
  description String?
  status      String   @default("ABERTO")
  createdAt   DateTime @default(now())
}
